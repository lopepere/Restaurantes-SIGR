APP_NAME=SIGR
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # genera con: ver instrucciones
APP_URL=https://tu-dominio.com

# Exposición del puerto web (por defecto solo localhost)
APP_BIND=127.0.0.1
APP_PORT=8000

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sigr
DB_USERNAME=sigr_user
DB_PASSWORD=CAMBIAME
DB_ROOT_PASSWORD=CAMBIAME

REDIS_HOST=redis
REDIS_PASSWORD=CAMBIAME
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# SMTP real (Mailpit no se usa en producción)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@tu-dominio.com
